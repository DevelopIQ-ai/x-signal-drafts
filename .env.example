# Required for reply monitoring
X_BEARER_TOKEN=

# Required for generating any drafts. Pick a text model available to your account.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional: send batches through AgentMail. Without these, drafts are printed to stdout.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
EMAIL_TO=

# Optional paths. State is deliberately local and should live on a persistent disk.
X_SIGNAL_CONFIG=./config.json
X_SIGNAL_STATE=./data/state.json
X_SIGNAL_CONTEXT=./data/context.jsonl
X_SIGNAL_FEED=./data/feed.jsonl

# Optional: port for the local web UI (serve/run commands).
PORT=3210

# Optional for the long-running mode.
TZ=America/Los_Angeles
